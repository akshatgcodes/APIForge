# Postgres in production (Neon etc.). Leave unset to use a local SQLite file.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/apiforge

# Password for the workspace. Required.
APP_PASSWORD=

# Signs the session cookie. Any long random string.
SESSION_SECRET=

# Where the React app runs (CORS)
FRONTEND_URL=http://localhost:5173

# true in production when frontend and API are on different domains
CROSS_SITE_COOKIES=false

# Let the proxy call localhost / private-network addresses. Handy locally for testing
# your own APIs; keep it false on any server other people can reach.
ALLOW_PRIVATE_TARGETS=true

# Public URL of this API. The example collection points at <this>/demo.
PUBLIC_API_URL=http://localhost:8000
